# Supabase — create a project at https://supabase.com, then paste values from
# Project Settings → API. Apply migrations in supabase/migrations via SQL editor
# or `supabase db push`.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Server-only. Needed by scripts/seed.ts and the push scheduler/cron tick.
# Never expose to the browser — this bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# App-side encryption key for storing user LLM API keys (32-byte hex, generate:
# openssl rand -hex 32). Required in production — the app hard-fails without it.
API_KEY_ENCRYPTION_KEY=

# Web Push (VAPID) — generate once with: npx web-push generate-vapid-keys
# The public key is safe to expose (it is sent to browsers); the private key
# must stay server-side.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Protects the /api/push/tick cron endpoint (Vercel Cron sends it as a
# Bearer token). Set to any long random string.
CRON_SECRET=

# Optional fallback LLM for the demo account (OpenAI-compatible endpoint).
# Users can configure their own providers in Settings → AI Providers.
DEMO_LLM_BASE_URL=
DEMO_LLM_API_KEY=
DEMO_LLM_MODEL=
